# Anthropic API 키를 여기에 넣으세요. (https://console.anthropic.com 에서 발급)
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 키를 넣으면 됩니다.
ANTHROPIC_API_KEY=sk-ant-여기에-실제-키

# (선택) 사용할 모델. 기본값은 claude-opus-4-8.
# 더 빠르고 저렴하게 쓰려면 claude-sonnet-5 또는 claude-haiku-4-5 로 바꾸세요.
# CLAUDE_MODEL=claude-sonnet-5

# (선택) 포트 번호. 기본값 3000.
# PORT=3000

# (선택, 배포 시 권장) 접근 암호.
# 이 값을 설정하면 앱에 들어올 때 암호를 물어봅니다. (URL 무단 사용 방지)
# 로컬에서는 비워두면 잠금 없이 바로 사용됩니다.
# APP_PASSWORD=원하는-암호
